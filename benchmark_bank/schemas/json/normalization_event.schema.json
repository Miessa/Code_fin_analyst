{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "normalization_event_id": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Normalization Event Id",
      "type": "string"
    },
    "ingestion_run_id": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Ingestion Run Id",
      "type": "string"
    },
    "observation_id": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Observation Id",
      "type": "string"
    },
    "field_name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Field Name",
      "type": "string"
    },
    "rule_id": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Rule Id",
      "type": "string"
    },
    "rule_version": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Rule Version",
      "type": "string"
    },
    "input_value": {
      "default": null,
      "title": "Input Value"
    },
    "output_value": {
      "default": null,
      "title": "Output Value"
    },
    "formula": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Formula"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "normalization_event_id",
    "ingestion_run_id",
    "observation_id",
    "field_name",
    "rule_id",
    "rule_version"
  ],
  "title": "NormalizationEvent",
  "type": "object"
}