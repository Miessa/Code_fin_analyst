{
  "$defs": {
    "RunStatus": {
      "enum": [
        "running",
        "succeeded",
        "partial",
        "failed"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "ingestion_run_id": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Ingestion Run Id",
      "type": "string"
    },
    "source_id": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Source Id",
      "type": "string"
    },
    "adapter_name": {
      "maxLength": 120,
      "minLength": 2,
      "title": "Adapter Name",
      "type": "string"
    },
    "adapter_version": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Adapter Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus",
      "default": "running"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "raw_artifact_path": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Artifact Path"
    },
    "raw_artifact_checksum_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Artifact Checksum Sha256"
    },
    "records_read": {
      "default": 0,
      "minimum": 0,
      "title": "Records Read",
      "type": "integer"
    },
    "records_accepted": {
      "default": 0,
      "minimum": 0,
      "title": "Records Accepted",
      "type": "integer"
    },
    "records_rejected": {
      "default": 0,
      "minimum": 0,
      "title": "Records Rejected",
      "type": "integer"
    },
    "warning_count": {
      "default": 0,
      "minimum": 0,
      "title": "Warning Count",
      "type": "integer"
    },
    "error_summary": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Summary"
    },
    "configuration": {
      "additionalProperties": true,
      "title": "Configuration",
      "type": "object"
    }
  },
  "required": [
    "ingestion_run_id",
    "source_id",
    "adapter_name",
    "adapter_version"
  ],
  "title": "IngestionRun",
  "type": "object"
}