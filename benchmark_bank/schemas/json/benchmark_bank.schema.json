    "ValueStatus": {
      "enum": [
        "reported",
        "derived",
        "estimated",
        "imputed"
      ],
      "title": "ValueStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "array"
    },
    "projects": {
      "items": {
        "$ref": "#/$defs/Project"
      },
      "title": "Projects",
      "type": "array"
    },
    "ingestion_runs": {
      "items": {
        "$ref": "#/$defs/IngestionRun"
      },
      "title": "Ingestion Runs",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "title": "Observations",
      "type": "array"
    },
    "normalization_events": {
      "items": {
        "$ref": "#/$defs/NormalizationEvent"
      },
      "title": "Normalization Events",
      "type": "array"
    }
  },
  "title": "BenchmarkBankDocument",
  "type": "object"
}