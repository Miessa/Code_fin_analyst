{
  "$defs": {
    "IngestionRun": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "ingestion_run_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Ingestion Run Id",
          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Id",
          "type": "string"
        },
        "adapter_name": {
          "maxLength": 120,
          "minLength": 2,
          "title": "Adapter Name",
          "type": "string"
        },
        "adapter_version": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Adapter Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RunStatus",
          "default": "running"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "raw_artifact_path": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Artifact Path"
        },
        "raw_artifact_checksum_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Artifact Checksum Sha256"
        },
        "records_read": {
          "default": 0,
          "minimum": 0,
          "title": "Records Read",
          "type": "integer"
        },
        "records_accepted": {
          "default": 0,
          "minimum": 0,
          "title": "Records Accepted",
          "type": "integer"
        },
        "records_rejected": {
          "default": 0,
          "minimum": 0,
          "title": "Records Rejected",
          "type": "integer"
        },
        "warning_count": {
          "default": 0,
          "minimum": 0,
          "title": "Warning Count",
          "type": "integer"
        },
        "error_summary": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Summary"
        },
        "configuration": {
          "additionalProperties": true,
          "title": "Configuration",
          "type": "object"
        }
      },
      "required": [
        "ingestion_run_id",
        "source_id",
        "adapter_name",
        "adapter_version"
      ],
      "title": "IngestionRun",
      "type": "object"
    },
    "NormalizationEvent": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "normalization_event_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Normalization Event Id",
          "type": "string"
        },
        "ingestion_run_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Ingestion Run Id",
          "type": "string"
        },
        "observation_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Observation Id",
          "type": "string"
        },
        "field_name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Field Name",
          "type": "string"
        },
        "rule_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "input_value": {
          "default": null,
          "title": "Input Value"
        },
        "output_value": {
          "default": null,
          "title": "Output Value"
        },
        "formula": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Formula"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "normalization_event_id",
        "ingestion_run_id",
        "observation_id",
        "field_name",
        "rule_id",
        "rule_version"
      ],
      "title": "NormalizationEvent",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "observation_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Observation Id",
          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Id",
          "type": "string"
        },
        "project_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 2,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "ingestion_run_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Ingestion Run Id",
          "type": "string"
        },
        "metric": {
          "maxLength": 96,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Metric",
          "type": "string"
        },
        "observation_type": {
          "$ref": "#/$defs/ObservationType",
          "default": "project"
        },
        "value_status": {
          "$ref": "#/$defs/ValueStatus",
          "default": "reported"
        },
        "raw_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Value"
        },
        "raw_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Low"
        },
        "raw_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw High"
        },
        "raw_unit": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Unit"
        },
        "normalized_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Value"
        },
        "normalized_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Low"
        },
        "normalized_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized High"
        },
        "normalized_unit": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Unit"
        },
        "normalization_status": {
          "default": "not_normalized",
          "maxLength": 50,
          "title": "Normalization Status",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "price_year": {
          "anyOf": [
            {
              "maximum": 2200,
              "minimum": 1800,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Year"
        },
        "value_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Date"
        },
        "statistic": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statistic"
        },
        "scenario": {
          "anyOf": [
            {
              "maxLength": 250,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario"
        },
        "economic_perimeter": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Economic Perimeter"
        },
        "estimate_stage": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimate Stage"
        },
        "includes_taxes": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Includes Taxes"
        },
        "includes_financing_costs": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Includes Financing Costs"
        },
        "source_location": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Source Location",
          "type": "string"
        },
        "source_excerpt": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Excerpt"
        },
        "quality_level": {
          "$ref": "#/$defs/QualityLevel",
          "default": "unknown"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "unreviewed"
        },
        "derivation_formula": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Derivation Formula"
        },
        "input_observation_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 2,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Input Observation Ids",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "observation_id",
        "source_id",
        "ingestion_run_id",
        "metric",
        "source_location"
      ],
      "title": "Observation",
      "type": "object"
    },
    "ObservationType": {
      "enum": [
        "project",
        "sector_statistic",
        "reference_point",
        "financing_instrument"
      ],
      "title": "ObservationType",
      "type": "string"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "project_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "project_name": {
          "maxLength": 300,
          "minLength": 2,
          "title": "Project Name",
          "type": "string"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "country_name": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country Name"
        },
        "country_iso3": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country Iso3"
        },
        "region": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "subregion": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subregion"
        },
        "technology": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Technology"
        },
        "project_type": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Type"
        },
        "revenue_model": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revenue Model"
        },
        "latitude": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latitude"
        },
        "longitude": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Longitude"
        },
        "identity_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "unreviewed"
        },
        "merged_into_project_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 2,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Merged Into Project Id"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "project_id",
        "project_name"
      ],
      "title": "Project",
      "type": "object"
    },
    "QualityLevel": {
      "enum": [
        "unknown",
        "low",
        "medium",
        "high"
      ],
      "title": "QualityLevel",
      "type": "string"
    },
    "ReviewStatus": {
      "enum": [
        "unreviewed",
        "pending",
        "verified",
        "rejected",
        "superseded"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "RunStatus": {
      "enum": [
        "running",
        "succeeded",
        "partial",
        "failed"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Id",
          "type": "string"
        },
        "organization": {
          "maxLength": 200,
          "minLength": 2,
          "title": "Organization",
          "type": "string"
